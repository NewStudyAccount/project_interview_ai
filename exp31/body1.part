  <text x="392" y="294" font-size="10.5" fill="#6b7683" text-anchor="end">4500</text>
  <text x="420" y="294" font-size="10.5" fill="#6b7683" text-anchor="end">4800</text>
  <text x="448" y="294" font-size="10.5" fill="#6b7683" text-anchor="end">4950</text>
  <text x="74" y="86" font-size="10.5" fill="#6b7683" text-anchor="end">5000</text>

