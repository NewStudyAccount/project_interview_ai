  </defs>
  <text x="20" y="24" font-size="13" font-weight="700" fill="#1a1d21">c=10、S=2ms：吞吐封顶 5000，等待在 80% 之后开始失控</text>

  <!-- 坐标 -->
  <line x1="80" y1="290" x2="560" y2="290" stroke="#6b7683" stroke-width="1.2" marker-end="url(#a4)"/>
