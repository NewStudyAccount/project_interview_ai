<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Java 面试深挖 31 · 连接池与资源隔离</title>
<style>
:root{
  --ink:#1a1d21; --ink2:#3d454e; --muted:#6b7683; --line:#e4e8ed; --line2:#d4dae1;
  --bg:#ffffff; --panel:#f7f9fb; --panel2:#eef2f6;
  --blue:#1a5fb4; --blue-soft:#e8f0fb;
  --red:#c62828; --red-soft:#fdeceb;
  --green:#1e7d3c; --green-soft:#e9f5ec;
  --amber:#9a6400; --amber-soft:#fdf4e3;
  --purple:#6a3fa0; --purple-soft:#f2ecfb;
}
*{box-sizing:border-box}
body{
  margin:0; background:var(--bg); color:var(--ink);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  font-size:15px; line-height:1.78; -webkit-font-smoothing:antialiased;
}
.wrap{max-width:1000px; margin:0 auto; padding:0 28px 80px}
.hero{padding:56px 0 30px; border-bottom:2px solid var(--ink)}
.hero .kicker{font-size:12.5px; letter-spacing:.16em; color:var(--muted); text-transform:uppercase; font-weight:600}
.hero h1{margin:14px 0 10px; font-size:35px; line-height:1.26; letter-spacing:-.5px; font-weight:800}
.hero .sub{color:var(--ink2); font-size:16.5px; max-width:820px}
.hero .meta{margin-top:22px; display:flex; flex-wrap:wrap; gap:8px}
.tag{font-size:12.5px; padding:4px 11px; border-radius:999px; background:var(--panel2); color:var(--ink2); font-weight:600}
.tag.b{background:var(--blue-soft); color:var(--blue)}
.tag.r{background:var(--red-soft); color:var(--red)}
.tag.g{background:var(--green-soft); color:var(--green)}
.tag.a{background:var(--amber-soft); color:var(--amber)}

h2{
  margin:56px 0 18px; padding:14px 0 14px 18px; font-size:23px; font-weight:800; letter-spacing:-.2px;
  border-left:4px solid var(--blue); background:linear-gradient(90deg,var(--blue-soft),transparent 62%);
  border-radius:0 6px 6px 0;
}
h2 .n{display:inline-block; min-width:38px; color:var(--blue); font-variant-numeric:tabular-nums}
h3{margin:32px 0 12px; font-size:17.5px; font-weight:750; color:var(--ink)}
h3::before{content:""; display:inline-block; width:6px; height:6px; background:var(--blue); border-radius:1px; margin-right:9px; vertical-align:2px}
p{margin:12px 0}
strong{font-weight:700; color:#101418}
em{font-style:normal; background:linear-gradient(transparent 62%, #ffe9a8 62%); padding:0 1px}
code{font-family:"JetBrains Mono",Consolas,"Courier New",monospace; font-size:13px; background:var(--panel2);
  padding:1.5px 5px; border-radius:4px; color:#a03060}
.lead{font-size:16px; color:var(--ink2)}

ul,ol{margin:12px 0; padding-left:22px}
li{margin:7px 0}
li::marker{color:var(--muted)}

table{width:100%; border-collapse:collapse; margin:20px 0; font-size:13.5px; background:#fff}
th{background:var(--panel2); text-align:left; padding:10px 12px; font-weight:700; border-bottom:2px solid var(--line2); font-size:13px}
td{padding:9px 12px; border-bottom:1px solid var(--line); vertical-align:top}
tr:last-child td{border-bottom:1px solid var(--line2)}
td code{font-size:12.5px}
.num{font-variant-numeric:tabular-nums}

pre{
  position:relative; margin:20px 0; padding:18px 18px 16px; background:#1c2128; color:#d7dde5;
  border-radius:9px; overflow-x:auto; font-size:13px; line-height:1.68;
  font-family:"JetBrains Mono",Consolas,"Courier New",monospace;
}
pre::before{content:attr(data-lang); position:absolute; top:0; right:0; font-size:10.5px; letter-spacing:.1em;
  color:#7d8794; background:#252b33; padding:3px 10px; border-radius:0 9px 0 6px; text-transform:uppercase}
pre code{background:none; padding:0; color:inherit; font-size:inherit}
.k{color:#ff7b72}
.s{color:#a5d6a7}
.c{color:#8b949e; font-style:italic}
.n{color:#79c0ff}

figure{margin:26px 0; background:var(--panel); border:1px solid var(--line); border-radius:11px; padding:18px 18px 10px}
figure svg{display:block; width:100%; height:auto}
figcaption{margin-top:8px; font-size:12.5px; color:var(--muted); text-align:center; line-height:1.6}
figcaption b{color:var(--ink2)}

.box{border-radius:9px; padding:14px 18px; margin:20px 0; border:1px solid var(--line2); background:var(--panel)}
.box .h{font-weight:750; font-size:13.5px; letter-spacing:.02em; margin-bottom:6px; display:flex; align-items:center; gap:8px}
.box p:last-child{margin-bottom:0}
.box.blue{background:var(--blue-soft); border-color:#bcd4f2} .box.blue .h{color:var(--blue)}
.box.red{background:var(--red-soft); border-color:#f3c9c6} .box.red .h{color:var(--red)}
.box.green{background:var(--green-soft); border-color:#c2e2cc} .box.green .h{color:var(--green)}
.box.amber{background:var(--amber-soft); border-color:#efd9ab} .box.amber .h{color:var(--amber)}
.box.purple{background:var(--purple-soft); border-color:#d7c9ef} .box.purple .h{color:var(--purple)}

.grid2{display:grid; grid-template-columns:1fr 1fr; gap:16px; margin:20px 0}
.grid3{display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin:20px 0}
.card{background:#fff; border:1px solid var(--line); border-radius:9px; padding:14px 16px}
.card .t{font-weight:750; font-size:14px; margin-bottom:5px; color:var(--ink)}
.card .d{font-size:13px; color:var(--ink2); line-height:1.65}
.card.r{border-top:3px solid var(--red)} .card.g{border-top:3px solid var(--green)}
.card.b{border-top:3px solid var(--blue)} .card.a{border-top:3px solid var(--amber)}

.qa{border-left:3px solid var(--line2); padding:2px 0 2px 16px; margin:18px 0}
.qa .q{font-weight:750; color:var(--ink); font-size:14.5px}
.qa .q::before{content:"Q "; color:var(--blue); font-weight:800}
.qa .a{color:var(--ink2); font-size:14px; margin-top:5px}
.qa .a::before{content:"A "; color:var(--green); font-weight:800}

.mt{background:#fff; border:1px solid var(--line); border-radius:11px; padding:20px 22px; margin:24px 0}
.mt .qh{font-weight:800; font-size:15.5px; margin-bottom:10px; color:var(--ink)}
.mt .qh span{background:var(--ink); color:#fff; font-size:11.5px; padding:2px 8px; border-radius:4px; margin-right:9px; letter-spacing:.05em}
.lv{margin-top:14px; padding:11px 14px; border-radius:7px; font-size:13.5px; line-height:1.7}
.lv .lb{font-weight:750; font-size:12px; letter-spacing:.05em; margin-right:8px}
.lv.l1{background:#fbeceb; border-left:3px solid #d9534f} .lv.l1 .lb{color:#c62828}
.lv.l2{background:#fdf6e6; border-left:3px solid #d9a441} .lv.l2 .lb{color:#9a6400}
.lv.l3{background:#eaf2fd; border-left:3px solid #4a86c8} .lv.l3 .lb{color:#1a5fb4}
.lv.l4{background:#eaf6ee; border-left:3px solid #3f9b5c} .lv.l4 .lb{color:#1e7d3c}

.foot{margin-top:70px; padding-top:26px; border-top:1px solid var(--line); color:var(--muted); font-size:13px}
.next{margin-top:26px; background:var(--panel2); border-radius:9px; padding:16px 20px; font-size:13.5px; color:var(--ink2)}
</style>